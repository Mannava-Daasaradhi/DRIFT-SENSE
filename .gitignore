.venv/
__pycache__/
*.pyc

# Generated pairs are large and reproducible from a seed - keep one sample
# pair committed per repo requirement #2, gitignore the rest (PLAN.md S3).
data/*
!data/dev_v0
data/dev_v0/*
!data/dev_v0/dram_00000
!data/eval
data/eval/*
!data/eval/dram_00000

weights/*.pt
!weights/reranker.pt

# Most figures are regenerated by evaluate.py/viz.py, but the slide-deck assets
# are committed so a reviewer sees the results without running anything.
figures/*
!figures/sem_physics_stages.png
!figures/noise_ladder_accuracy.png
!figures/accuracy_vs_baseline.png
!figures/error_cdf.png
!figures/reliability.png
!figures/success_case.png
!figures/honest_failure_case.png

# Evaluation output is committed as evidence: every number quoted in the README
# and on the slides must be traceable to a file in the repository.
!results.json
!results_ood.json
