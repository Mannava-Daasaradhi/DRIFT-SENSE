.venv/
__pycache__/
*.pyc

# Generated pairs are large and reproducible from a seed - keep one sample
# pair committed per repo requirement #2, gitignore the rest (PLAN.md S3).
data/*
!data/dev_v0
data/dev_v0/*
!data/dev_v0/dram_00000
!data/eval
data/eval/*
!data/eval/dram_00000

weights/*.pt
!weights/reranker.pt

# Most figures are regenerated by evaluate.py/viz.py, but hand-picked
# slide-deck assets (e.g. the SEM physics stage strip, A2.3) are committed.
figures/*
!figures/sem_physics_stages.png
